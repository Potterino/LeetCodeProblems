class Solution:
    def sortColors(self, nums: List[int]) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        color_list = [0, 1, 2]
        count_list = []
        for i in color_list:
            occ = nums.count(i)
            count_list.append(occ)
        nums.clear()
        for i in range(len(color_list)):
            for count in range(count_list[i]):
                nums.append(i)
        return nums
