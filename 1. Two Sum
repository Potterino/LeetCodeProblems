"""
Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.

You may assume that each input would have exactly one solution, and you may not use the same element twice.

You can return the answer in any order.

 

Example 1:

Input: nums = [2,7,11,15], target = 9
Output: [0,1]
Explanation: Because nums[0] + nums[1] == 9, we return [0, 1].
Example 2:

Input: nums = [3,2,4], target = 6
Output: [1,2]
Example 3:

Input: nums = [3,3], target = 6
Output: [0,1]
 

Constraints:

2 <= nums.length <= 104
-109 <= nums[i] <= 109
-109 <= target <= 109
Only one valid answer exists.
"""

class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        # create a result array
        result = []
        # create an empty set to be able to search for every value of the input list in O(n)
        nums_set = set()
        # loop through the list and keep track off the current index (in case our target value is an addition of two equal numbers)
        for index, number in enumerate(nums):
            # calculate the expected number
            expected_number = target - number 
            # if the expected number is in the set
            if expected_number in nums_set: 
                # append the first index of the expected number
                result.append(nums.index(expected_number))
                # and the current index of the (equal) number
                result.append(index)
                return result
            # else add the current number to the set
            nums_set.add(number)
